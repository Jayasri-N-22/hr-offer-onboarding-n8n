        "subject": "=New hire confirmed: {{ $('Prepare Candidate Data').item.json.candidate_name }}",
        "message": "=<p>Hi {{ $('Prepare Candidate Data').item.json.manager_name }},</p><p>{{ $('Prepare Candidate Data').item.json.candidate_name }} has signed the offer for <strong>{{ $('Prepare Candidate Data').item.json.role_title }}</strong> and will start on <strong>{{ $('Prepare Candidate Data').item.json.start_date }}</strong>.</p><p>An onboarding checklist has been created. Please review and prepare for their first day.</p><p>HR</p>",
