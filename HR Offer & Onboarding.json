    {
      "parameters": {
        "folderId": "<__PLACEHOLDER_VALUE__Google Drive folder ID for offer letters__>",
        "title": "=Offer Letter - {{ $json.candidate_name }} ({{ $json.role_title }})"
      },
      "id": "e8a5558d-0e09-4d4f-9f2d-0681f6efd421",
      "name": "Create Offer Doc",
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentURL": "={{ $json.id }}",
        "actionsUi": {
          "actionFields": [
            {
              "action": "insert",
              "text": "=Dear {{ $('Prepare Candidate Data').item.json.candidate_name }},\n\nWe are delighted to offer you the position of {{ $('Prepare Candidate Data').item.json.role_title }} in the {{ $('Prepare Candidate Data').item.json.department }} department.\n\nStart date: {{ $('Prepare Candidate Data').item.json.start_date }}\nCompensation: {{ $('Prepare Candidate Data').item.json.salary }}\nReporting manager: {{ $('Prepare Candidate Data').item.json.manager_name }}\n\nTo accept this offer, please sign below.\n\nSignature: /sig/\n\nWarm regards,\nHuman Resources"
            }
          ]
        }
      },
      "id": "bbfda50c-5dcb-4ce3-a29f-d95746c868ae",
      "name": "Fill Offer Letter",
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 2,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Select HR/onboarding channel"
        },
        "text": "=:page_facing_up: Offer letter generated for *{{ $('Prepare Candidate Data').item.json.candidate_name }}* ({{ $('Prepare Candidate Data').item.json.role_title }}). Sending for e-signature now.",
        "otherOptions": {}
      },
      "id": "a5dfc9e9-7907-47d0-85e8-dab469b3ab0d",
      "name": "Notify HR - Offer Generated",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.5,
      "position": [
        896,
        0
      ],
      "webhookId": "bd9b8553-ed41-433f-b88c-32f3f3cb5d65"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Prepare Candidate Data').item.json.candidate_email }}",
        "subject": "=Your offer letter - {{ $('Prepare Candidate Data').item.json.role_title }}",
        "message": "=<p>Dear {{ $('Prepare Candidate Data').item.json.candidate_name }},</p><p>Congratulations! We are excited to offer you the role of <strong>{{ $('Prepare Candidate Data').item.json.role_title }}</strong>.</p><p>You can review your offer letter here: <a href=\"https://docs.google.com/document/d/{{ $('Create Offer Doc').item.json.id }}/edit\">Offer Letter</a></p><p>A separate email will arrive shortly asking you to sign the offer electronically.</p><p>Warm regards,<br/>Human Resources</p>",
        "options": {}
      },
      "id": "6073d81f-6824-4a58-94f2-3eee82d9c9a0",
      "name": "Email Offer to Candidate",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        896,
        192
      ],
      "webhookId": "45f44267-79c9-447d-8e00-e510c6ad0c60"
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $('Create Offer Doc').item.json.id }}/export?mimeType=application/pdf",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "eee8b13f-a64d-4a09-9877-ad39f571af0d",
      "name": "Export Offer as PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        896,
        384
      ]
    },
    {
      "parameters": {
        "operation": "binaryToPropery",
        "destinationKey": "docBase64",
        "options": {}
      },
      "id": "64d83f13-c9a1-45fd-ab60-823ebec5796e",
      "name": "Encode PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1120,
        384
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "<__PLACEHOLDER_VALUE__DocuSign envelopes URL, e.g. https://demo.docusign.net/restapi/v2.1/accounts/{accountId}/envelopes__>",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"emailSubject\": \"Please sign your offer letter - {{ $('Prepare Candidate Data').item.json.role_title }}\",\n  \"documents\": [\n    { \"documentBase64\": \"{{ $json.docBase64 }}\", \"name\": \"Offer Letter\", \"fileExtension\": \"pdf\", \"documentId\": \"1\" }\n  ],\n  \"recipients\": {\n    \"signers\": [\n      {\n        \"email\": \"{{ $('Prepare Candidate Data').item.json.candidate_email }}\",\n        \"name\": \"{{ $('Prepare Candidate Data').item.json.candidate_name }}\",\n        \"recipientId\": \"1\",\n        \"routingOrder\": \"1\",\n        \"tabs\": { \"signHereTabs\": [ { \"anchorString\": \"/sig/\", \"anchorUnits\": \"pixels\", \"anchorXOffset\": \"0\", \"anchorYOffset\": \"0\" } ] }\n      }\n    ]\n  },\n  \"eventNotification\": {\n    \"url\": \"{{ $execution.resumeUrl }}\",\n    \"requireAcknowledgment\": \"true\",\n    \"loggingEnabled\": \"true\",\n    \"envelopeEvents\": [\n      { \"envelopeEventStatusCode\": \"completed\" },\n      { \"envelopeEventStatusCode\": \"declined\" },\n      { \"envelopeEventStatusCode\": \"voided\" }\n    ]\n  },\n  \"status\": \"sent\"\n}",
        "options": {}
      },
      "id": "8e491655-6c66-47ca-9db2-2c4dbcaf159b",
      "name": "Send for E-Signature",
